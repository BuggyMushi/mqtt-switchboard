{
  "server": {
    "listen": "127.0.0.1:8080",
    "session_timeout_days": 7,
    "debounce_ms": 1000,
    "cookie_secure": false
  },
  "mqtt": {
    "broker": "tcp://127.0.0.1:1883",
    "client_id": "mqtt_switchboard_daemon",
    "username": "",
    "password": "",
    "keep_alive_sec": 30,
    "discovery_prefix": "homeassistant"
  },
  "security": {
    "max_login_attempts": 5,
    "lockout_minutes": 15
  },
  "users": [
    {
      "username": "admin",
      "password": "admin_password_change_me"
    }
  ],
  "devices": [
    {
      "id": "relay_ch1",
      "name": "走廊保溫燈 (繼電器 1)",
      "component": "switch",
      "cmd_topic": "mushi/relay8ch/ch1/set",
      "state_topic": "mushi/relay8ch/ch1/state",
      "payload_on": "ON",
      "payload_off": "OFF"
    },
    {
      "id": "egg_roller_trigger",
      "name": "手動滾蛋 (EggRoller)",
      "component": "button",
      "cmd_topic": "mushi/eggroller/ManualRoll",
      "payload_press": "switch"
    }
  ]
}
