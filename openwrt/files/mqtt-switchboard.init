#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/mqtt-switchboard
CONF_DIR=/etc/mqtt-switchboard
CONF_FILE="$CONF_DIR/config.json"

init_config() {
	config_load "mqtt-switchboard"

	config_get_bool enabled "main" "enabled" 1
	config_get listen_addr "main" "listen_addr" "0.0.0.0"
	config_get listen_port "main" "listen_port" "8080"
	config_get broker_url "main" "broker_url" "tcp://127.0.0.1:1883"
	config_get broker_client_id "main" "broker_client_id" "mqtt_switchboard_wrt"
	config_get broker_user "main" "broker_user" ""
	config_get broker_pass "main" "broker_pass" ""
	config_get discovery_prefix "main" "discovery_prefix" "homeassistant"
	config_get debounce_ms "main" "debounce_ms" "1000"
	config_get session_timeout "main" "session_timeout" "7"
	config_get_bool cookie_secure "main" "cookie_secure" 0
	config_get admin_user "main" "admin_user" ""
	config_get admin_password "main" "admin_password" ""

	# Collect all user accounts from UCI
	USERS_JSON=""
	append_user() {
		local cfg="$1"
		local u p
		config_get u "$cfg" username
		config_get p "$cfg" password
		[ -n "$u" ] && [ -n "$p" ] && {
			[ -n "$USERS_JSON" ] && USERS_JSON="${USERS_JSON},"
			USERS_JSON="${USERS_JSON}
    {
      \"username\": \"$u\",
      \"password\": \"$p\"
    }"
		}
	}
	config_foreach append_user "user"

	# Fallback if no 'user' sections exist: use main section's admin_user
	if [ -z "$USERS_JSON" ]; then
		local def_u="${admin_user:-admin}"
		local def_p="${admin_password:-admin}"
		USERS_JSON="
    {
      \"username\": \"$def_u\",
      \"password\": \"$def_p\"
    }"
	fi

	# Always sync and generate config.json from UCI
	mkdir -p "$CONF_DIR"
	cat <<EOF > "$CONF_FILE"
{
  "server": {
    "listen": "${listen_addr}:${listen_port}",
    "session_timeout_days": ${session_timeout},
    "debounce_ms": ${debounce_ms},
    "cookie_secure": $([ "$cookie_secure" -eq 1 ] && echo true || echo false)
  },
  "mqtt": {
    "broker": "${broker_url}",
    "client_id": "${broker_client_id}",
    "username": "${broker_user}",
    "password": "${broker_pass}",
    "discovery_prefix": "${discovery_prefix}"
  },
  "security": {
    "max_login_attempts": 5,
    "lockout_minutes": 15
  },
  "users": [${USERS_JSON}
  ]
}
EOF
}

start_service() {
	init_config

	[ "$enabled" -eq 1 ] || {
		echo "mqtt-switchboard is disabled in UCI."
		return 0
	}

	procd_open_instance "mqtt-switchboard"
	procd_set_param command "$PROG" \
		-config "$CONF_FILE" \
		-listen "${listen_addr}:${listen_port}" \
		-broker "$broker_url" \
		-discovery "$discovery_prefix" \
		-debounce "$debounce_ms"

	[ -n "$broker_user" ] && procd_append_param command -user "$broker_user"
	[ -n "$broker_pass" ] && procd_append_param command -pass "$broker_pass"
	[ -n "$broker_client_id" ] && procd_append_param command -client-id "$broker_client_id"
	[ "$cookie_secure" -eq 1 ] && procd_append_param command -cookie-secure

	# Automatically respawn service if it crashes (5 retries, 3600s reset, 5s delay)
	procd_set_param respawn 3600 5 5

	# Memory safety limits: 32MB max address space, zero core dumps
	procd_set_param limits as=33554432
	procd_set_param limits core="0"

	# Direct logs to system logd/syslog
	procd_set_param stdout 1
	procd_set_param stderr 1

	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "mqtt-switchboard"
}
